# Copy to .env NEXT TO docker-compose.deploy.yml on the server. Never commit it.
#
# Values are read literally from this file — do not quote them, and do not
# escape the $ in the bcrypt hash. (The $$ escaping rule applies to compose
# YAML, not to .env.) `docker compose` strips surrounding quotes but
# `docker run --env-file` does not, so a quoted key reaches the provider two
# characters too long and is rejected as invalid, with no hint of the cause.

# --- Public identity ------------------------------------------------------
# The domain Caddy serves and obtains a certificate for. Its DNS record must
# already point at this host.
DEPLOY_DOMAIN=memassist.duckdns.org

# --- Access control -------------------------------------------------------
# Generate the hash on any machine with Caddy, including this one:
#   docker run --rm caddy:2-alpine caddy hash-password --plaintext 'your-password'
CADDY_USER=demo
CADDY_HASH=$2a$14$REPLACE_WITH_OUTPUT_OF_caddy_hash_password

# --- Images ---------------------------------------------------------------
# Pin a release tag to make rollback a one-line edit; `latest` follows the
# newest non-prerelease tag. The deploy workflow overrides this per run.
# MEMASSIST_VERSION=1.1.0

# --- Database -------------------------------------------------------------
# Required, no default. The stack refuses to start without it rather than
# booting with a password published in a public repository.
POSTGRES_PASSWORD=CHANGE_ME
# POSTGRES_USER=memassist
# POSTGRES_DB=memassist

# --- Provider keys --------------------------------------------------------
# At least one. The router tries them in this order and fails over.
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
MISTRAL_API_KEY=

# --- Optional -------------------------------------------------------------
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST=https://cloud.langfuse.com
