# Copy to .env and fill in. .env is git-ignored; never commit real secrets.

# --- LLM provider keys (free tiers) --------------------------------------
# The router (llm/router.py) tries providers in priority order and fails over.
# Phase 1 runs on whichever keys are present; you need at least one. Gemini +
# Groq is the recommended Phase 1 pair (kill GEMINI_API_KEY to watch failover).
# GOOGLE_API_KEY is the superseded name for GEMINI_API_KEY: still honoured, but
# it logs a deprecation warning on startup.
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
GROQ_API_KEY=YOUR_GROQ_API_KEY
OPENROUTER_API_KEY=YOUR_OPENROUTER_API_KEY
MISTRAL_API_KEY=YOUR_MISTRAL_API_KEY
# --- Optional overrides (defaults live in config.py) ---------------------

# Sampling temperature used for every provider (kept fixed for a stable voice
# as the underlying model changes mid-conversation).
# MEMASSIST_TEMPERATURE=0.3

# Path to the provider chain config.
# MEMASSIST_PROVIDERS_YAML=./llm/providers.yaml

# Fraction of the active provider's context window at which the memory-pressure
# warning fires.
# MEMASSIST_PRESSURE_THRESHOLD=0.7

# Storage locations (created automatically if missing).
# MEMASSIST_DB_PATH=./data/memassist.db
# MEMASSIST_CHROMA_PATH=./data/chroma

# --- Phase 4: docker compose ---------------------------------------------
# Read by docker-compose.yml. Defaults work out of the box; change the password
# before exposing Postgres anywhere but localhost.
# POSTGRES_USER=memassist
# POSTGRES_PASSWORD=memassist
# POSTGRES_DB=memassist
# The HOST port Postgres is published on. Defaults to 15432, deliberately NOT
# 5432: a native Postgres install or another compose stack with
# `restart: always` commonly owns 5432 already, and `docker compose up` would
# fail with "port is already allocated" before anything else could run.
# Renamed from POSTGRES_PORT, which was ambiguous about which side it set.
# (Services inside the network always use postgres:5432 and ignore this.)
# POSTGRES_HOST_PORT=15432
# API_PORT=8000
# WEB_PORT=3000

# The API address as seen from the BROWSER (baked into the client bundle at
# build time, so it cannot be changed at runtime).
# NEXT_PUBLIC_API_BASE=http://localhost:8000

# Storage backend. Setting the DSN alone switches it; leave unset for
# SQLite + Chroma with no setup.
# This is the HOST-side DSN — for running the app or the benchmark OUTSIDE a
# container against the compose database, so the port matches POSTGRES_HOST_PORT
# above. Services running INSIDE compose get their own DSN from the compose
# file and use postgres:5432.
# MEMASSIST_POSTGRES_DSN=postgresql://memassist:memassist@localhost:15432/memassist

# External MCP servers need uvx/npx, which the api image does not carry.
# MEMASSIST_EXTERNAL_TOOLS=0

# --- Phase 5: observability ----------------------------------------------
# Langfuse tracing: one trace per turn, a span per graph node and per tool,
# tagged with the serving provider and every security decision. Leave BOTH keys
# unset and tracing is entirely inert — no client, no threads, no network.
# Free tier: https://cloud.langfuse.com. Trace payloads are redacted through
# the same detector that gates the Mistral lane (security/sensitivity.py).
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
# Self-hosting instead? Point this at your instance and change nothing else.
# LANGFUSE_HOST=https://cloud.langfuse.com

# --- Phase 5: background consolidation -----------------------------------
# The Mistral lane summarizes recall into archival. Run it by hand with
#   python -m jobs.consolidate --dry-run     (shows the payload, sends nothing)
# or on a schedule with `docker compose --profile jobs up`, which reads this:
# MEMASSIST_CONSOLIDATE_EVERY=6h
# MEMASSIST_CONSOLIDATE_LIMIT=100
