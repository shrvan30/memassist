# Copy to .env and fill in. .env is git-ignored; never commit real secrets.
#
# Do not quote values. `docker compose` strips surrounding quotes but
# `docker run --env-file` does not, so a quoted key reaches the provider two
# characters too long and is rejected as invalid — with no hint that quoting
# was the cause.

# --- Provider keys --------------------------------------------------------
# At least one is required. The router tries them in this order and fails over.
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
GROQ_API_KEY=YOUR_GROQ_API_KEY
OPENROUTER_API_KEY=YOUR_OPENROUTER_API_KEY
MISTRAL_API_KEY=YOUR_MISTRAL_API_KEY
# GOOGLE_API_KEY: deprecated alias for GEMINI_API_KEY, still honoured.

# --- Model behaviour ------------------------------------------------------
# Fixed across providers so the assistant's voice does not change on failover.
# MEMASSIST_TEMPERATURE=0.3
# MEMASSIST_PROVIDERS_YAML=./llm/providers.yaml
# Fraction of the context window at which the agent is told to offload.
# MEMASSIST_PRESSURE_THRESHOLD=0.7
# Caps a single provider request. A server error costs another wait this long
# on the same provider, and four providers x this is the worst-case failover
# walk — which at 30s already equals the 120s the API waits for a whole turn.
# MEMASSIST_REQUEST_TIMEOUT=30.0

# --- Storage --------------------------------------------------------------
# Unset = SQLite + Chroma, no setup. Set = Postgres + pgvector for stores and
# turn state. Host-side, so it uses POSTGRES_HOST_PORT; in-network services use
# postgres:5432.
# MEMASSIST_POSTGRES_DSN=postgresql://memassist:memassist@localhost:15432/memassist
# MEMASSIST_DB_PATH=./data/memassist.db
# MEMASSIST_CHROMA_PATH=./data/chroma

# --- Docker compose -------------------------------------------------------
# Change the password before exposing Postgres beyond localhost.
# POSTGRES_USER=memassist
# POSTGRES_PASSWORD=memassist
# POSTGRES_DB=memassist
# Host port for Postgres. 15432, not 5432, which is commonly already taken.
# POSTGRES_HOST_PORT=15432
# API_PORT=8000
# WEB_PORT=3000
# Baked into the web bundle at build time, so changing it requires a rebuild.
# NEXT_PUBLIC_API_BASE=http://localhost:8000
# External MCP servers need uvx/npx, which the api image does not carry.
# MEMASSIST_EXTERNAL_TOOLS=0

# --- Observability --------------------------------------------------------
# Inert unless BOTH keys are set: no client, no network. Payloads are redacted
# by the same filter that gates the Mistral lane.
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
# Point at a self-hosted instance instead of Langfuse Cloud.
# LANGFUSE_HOST=https://cloud.langfuse.com

# --- Background consolidation ---------------------------------------------
# Used by `docker compose --profile jobs up`; opt-in, off by default.
# MEMASSIST_CONSOLIDATE_EVERY=6h
# MEMASSIST_CONSOLIDATE_LIMIT=100
